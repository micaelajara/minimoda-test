meta {
  name: CP04a · crear carrito (secuencia, paso 1)
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/carritos
  body: none
  auth: none
}

script:post-response {
  bru.setVar("carritoId", res.getBody().id);
}

tests {
  // Contrato: paths./carritos.post.responses.201 → esquema Carrito
  test("CP04a · 201 y carrito abierto y vacío", function () {
    expect(res.getStatus()).to.equal(201);
    expect(res.getBody().estado).to.equal("abierto");
    expect(res.getBody().items).to.be.an("array").that.is.empty;
  });
}
